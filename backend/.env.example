# Core keys (override keys in app/API_KEY.json)
SEARCH_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=

# Optional path overrides
CRAWL_PROMPTS_PATH=app/Prompts.json
CRAWL_API_KEYS_PATH=app/API_KEY.json
CRAWL_SESSION_ARTIFACTS_ROOT=/tmp/llm-crawl-sessions

# Crawl defaults
CRAWL_DEFAULT_PROMPT_PROFILE=general
CRAWL_DEFAULT_MODEL=deepseek-chat
CRAWL_MAX_ITERATIONS=100
CRAWL_MAX_RESULTS=10000
CRAWL_MAX_LINKS_PER_PAGE=8

# API server settings
CRAWL_API_HOST=0.0.0.0
CRAWL_API_PORT=8000
CRAWL_API_ALLOWED_ORIGINS=*
CRAWL_SESSION_ARTIFACT_TTL_SECONDS=1800
